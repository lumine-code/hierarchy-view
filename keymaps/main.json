{
  // `alt-k` rather than the obvious `alt-h`: macOS binds alt-h in the editor as
  // the Cocoa delete-to-beginning-of-word, which would leave this dead in an
  // editor there. `alt-v` sits on a deeper element in project-list and
  // recent-list, so it would take the key whenever one of those has focus.
  "lumine-workspace": {
    "alt-k": "hierarchy-view:toggle-focus"
  }
}
