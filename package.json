{
  "name": "hierarchy-view",
  "author": "lumine-code",
  "description": "Explore the callers, callees, supertypes and subtypes of a symbol.",
  "repository": "https://github.com/lumine-code/hierarchy-view",
  "bugs": {
    "url": "https://github.com/lumine-code/hierarchy-view/issues"
  },
  "keywords": [
    "callers",
    "callees",
    "supertypes",
    "subtypes",
    "inheritance",
    "navigation",
    "lsp"
  ],
  "version": "1.0.0",
  "license": "MIT",
  "engines": {
    "lumine": "^1.0.0"
  },
  "main": "./lib/main",
  "files": [
    "keymaps",
    "lib",
    "spec",
    "styles"
  ],
  "deserializers": {
    "hierarchy-view/HierarchyView": "deserializeHierarchyView"
  },
  "scripts": {
    "test": "lumine --test spec",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "providedServices": {
    "background-tips.provider": {
      "versions": {
        "1.0.0": "provideBackgroundTips"
      }
    }
  },
  "consumedServices": {
    "ide-client": {
      "versions": {
        "^1.0.0": "consumeIdeClient"
      }
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.4.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.9"
  },
  "configSchema": {
    "dockSide": {
      "title": "Dock Side",
      "description": "The dock in which the hierarchy opens.",
      "type": "string",
      "enum": [
        "left",
        "right"
      ],
      "default": "right"
    }
  }
}
